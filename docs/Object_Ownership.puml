@startuml Object_Ownership
skinparam defaultFontName Monospaced
skinparam shadowing false
skinparam linetype ortho
hide stereotype
skinparam object {
  BackgroundColor<<blue>>   #dae8fc
  BorderColor<<blue>>       #6c8ebf
  BackgroundColor<<yellow>> #fff2cc
  BorderColor<<yellow>>     #d6b656
  BackgroundColor<<green>>  #d5e8d4
  BorderColor<<green>>      #82b366
  BackgroundColor<<grey>>   #f5f5f5
  BorderColor<<grey>>       #666666
  FontColor<<grey>>         #333333
}

object "<u>app</u> : MyApp" as app <<blue>>

object "<u>commandQueue</u> : CommandQueue" as cq <<blue>>
object "<u>sceneManager</u> : SceneManager" as sm <<blue>>
object "<u>shaderManager</u> : ShaderManager" as shm <<blue>>
object "<u>camera</u> : Camera" as cam <<blue>>
object "<u>imguiVisitor</u> : ImGuiVisitor" as iv <<blue>>
object "<u>rendererVisitor</u> : OpenGLRendererVisitor" as rv <<blue>>

object "<u>linearSearch</u> : LinearSearch" as ls <<green>>
object "<u>coneStepMapping</u> : ConeStepMapping" as csm <<green>>

object "<u>model1</u> : Model" as mod1 <<yellow>>
object "<u>surface1</u> : RayMarchedSurface" as rms1 <<yellow>>

object "<u>transform</u> : Transform" as tr1 <<blue>>
object "<u>mesh</u> : Mesh" as msh <<blue>>
object "<u>transform</u> : Transform" as tr2 <<blue>>

object "<u>mat</u> : Material" as mat <<blue>>
object "<u>diffuseTex</u> : Texture" as tex <<blue>>

' MyApp exclusively owns value/unique_ptr members
app *-- cq
app *-- sm
app *-- shm
app *-- cam
app *-- iv
app *-- rv

' MyApp holds shared_ptr techniques (m_techniques map)
app o-- ls  : m_techniques
app o-- csm : m_techniques

' SceneManager holds shared_ptr drawables
sm o-- mod1 : m_drawables
sm o-- rms1 : m_drawables

' surface1.m_technique is a shared_ptr pointing to coneStepMapping
rms1 o-- csm : m_technique

' model1 exclusively owns its children
mod1 *-- tr1
mod1 *-- msh

' surface1 exclusively owns its children
rms1 *-- tr2

' Mesh and Material hold shared_ptr
msh o-- mat
mat o-- tex

' Non-owning raw pointer observers
iv ..> cq  : raw* (ICommandQueue*)
rv ..> cam : raw* (ICamera*)

legend right
  *--  unique_ptr / value member (exclusive owner)
  o--  shared_ptr (shared owner)
  ..>  raw* (non-owning observer)
endlegend
@enduml
