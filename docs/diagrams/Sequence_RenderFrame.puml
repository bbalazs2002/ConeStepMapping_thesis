@startuml Sequence_RenderFrame
skinparam defaultFontName Monospaced
skinparam shadowing false
hide stereotype
skinparam sequenceArrowThickness 1.5
skinparam participant {
  BackgroundColor<<blue>>   #dae8fc
  BorderColor<<blue>>       #6c8ebf
  BackgroundColor<<yellow>> #fff2cc
  BorderColor<<yellow>>     #d6b656
  BackgroundColor<<green>>  #d5e8d4
  BorderColor<<green>>      #82b366
  BackgroundColor<<grey>>   #f5f5f5
  BorderColor<<grey>>       #666666
  FontColor<<grey>>         #333333
}

participant "MyApp" as app <<blue>>
participant "SceneManager" as sm <<blue>>
participant "IModelRendererVisitable" as mb <<yellow>>
participant "OpenGLRendererVisitor" as rv <<blue>>
participant "SkyboxRenderer\n/ AxesRenderer" as sa <<blue>>
participant "DebugRenderer" as dr <<blue>>

== MyApp::Render() ==

app -> sa : skyboxRenderer.Render(camera)
sa --> app

note over app
  selected = m_selectedIndex >= 0
    ? dynamic_cast<ModelBase*>(
        m_sceneManager.GetSceneObjects()[m_selectedIndex].get())
    : nullptr
end note

app -> sm : sceneManager.Render(m_rendererVisitor)
activate sm

sm -> rv : v.SetSelected(m_selected)
note right of rv
  SceneManager is the authority on selection;
  visitor receives the raw non-owning pointer
  once per frame before the draw loop
end note

loop for each IModelRendererVisitable in m_rendererVisitables
  sm -> mb : AcceptRendererVisitor(v)
  activate mb
  mb -> rv : v.Visit(*this)
  activate rv
  rv -> rv : VisitModelBase(target)
  note right
    uploads: transformData.world
             cameraData.viewProj + eye
    reads m_camera live — no manual sync needed
  end note
  rv --> mb
  deactivate rv
  deactivate mb
end

deactivate sm

opt m_debugState.config.showDebug
  app -> dr : debugRenderer.Render(m_debugState, camera)
  dr --> app
end

opt m_showAxes
  app -> sa : axesRenderer.Render(camera)
  sa --> app
end

== MyApp::RenderGUI() ==

app -> sm : sceneManager.RenderGUI(m_imguiVisitor)
note right of sm
  iterates m_sceneObjects;
  each calls AcceptGUIVisitor(v)
  → v.Visit(*this)
end note
sm --> app

@enduml
